# ============================================================
#  部署本地配置模板
# ============================================================
#  用法：复制成 .env 后按需修改（.env 已在 .gitignore 里，不会被提交）
#
#      cp .env.example .env
#
#  设计动机：私有镜像仓库前缀、宿主机端口这类「因部署环境而异」的值，
#  如果直接写进 Dockerfile / docker-compose.yml，每次 git pull 都会冲突，
#  被迫在服务器上保留本地改动。外置到 .env 后，被跟踪的文件保持原样，
#  服务器只维护一个永不冲突的 .env。
# ============================================================


# ---------- 基础镜像仓库前缀 ----------
# 留空 = Docker Hub 官方（eclipse-temurin:17-jdk / 17-jre）
# 私有仓库或镜像加速场景填前缀，⚠️ 结尾必须带斜杠
#   IMAGE_REGISTRY=docker.kaixuan.cloud:33577/
IMAGE_REGISTRY=


# ---------- 宿主机端口 ----------
# 默认 8351；被占用时改这里（容器内始终是 8351，无需改 Dockerfile）
#   HOST_PORT=30089
HOST_PORT=8351


# ---------- 构建期下载源（国内服务器保持默认即可） ----------
# 需要换回官方源时取消注释：
#   MAVEN_MIRROR_URL=https://repo.maven.apache.org/maven2
#   MVNW_REPOURL=https://repo.maven.apache.org/maven2
#   NODE_DOWNLOAD_ROOT=https://nodejs.org/dist/
#   NPM_REGISTRY_URL=https://registry.npmjs.org/
